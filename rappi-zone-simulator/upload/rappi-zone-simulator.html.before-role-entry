function buildStudentCardHtml(z, opts){
  opts = opts || {};
  const s = state[z.id];
  const isClosed = isZoneClosed(s);
  const blocked = !!opts.blocked;
  const color = colorForStress(s.stress);
  const onCooldown = (cooldownUntil[z.id] || 0) > Date.now();
  const qs = quizState[z.id];

  let bodyHtml;
  if (isClosed){
    bodyHtml = `<button class="orderBtn" disabled>🚫 Zona cerrada</button>`;
  } else if (blocked){
    bodyHtml = `<button class="orderBtn" disabled>🚫 Bloqueado para tu zona</button>`;
  } else if (onCooldown){
    bodyHtml = `
      <button class="orderBtn sent" disabled>✅ Pedido enviado</button>
      <div class="sz-note">¡Gracias! Responde otra pregunta para volver a pedir en unos segundos.</div>
    `;
  } else if (!qs.unlocked){
    const question = QUIZ[qs.qIndex];
    const optsHtml = question.options.map((opt, i) => `
      <button class="quiz-opt" data-quiz-zone="${z.id}" data-quiz-opt="${i}">${opt}</button>
    `).join('');
    const msgHtml = qs.wrong
      ? `<div class="quiz-msg wrong">Casi... inténtalo de nuevo</div>`
      : `<div class="quiz-msg">Responde correctamente para desbloquear tu pedido</div>`;
    bodyHtml = `
      <div class="quiz">
        <div class="quiz-q">${question.q}</div>
        ${optsHtml}
        ${msgHtml}
      </div>
    `;
  } else {
    bodyHtml = `
      <div class="quiz-msg right">🎉 ¡Correcto! Ya puedes pedir</div>
      <button class="orderBtn" data-order-zone="${z.id}">🛵 Pedir ahora</button>
    `;
  }

  return `
    <div class="sz-card" style="--zone-color:${color}">
      <div class="sz-name">${s.name}${opts.homeTag ? ' <span style="font-size:10px;color:var(--text-dim);">(tu zona)</span>' : ''}</div>
      <div class="sz-tag">${s.tag}</div>
      <div class="sz-eta">${isClosed ? '—' : Math.round(s.eta) + ' min'}</div>
      <div class="sz-eta-label">${isClosed ? 'zona cerrada' : 'ETA actual'}</div>
      ${bodyHtml}
    </div>
  `;
}

function renderRolePicker(){
  studentTitleEl.textContent = 'Elige tu rol';
  studentSubEl.textContent = 'Unos serán clientes, otros serán el equipo de operaciones.';
  studentGrid.innerHTML = `
    <div class="sz-card" style="--zone-color:${'#078A72'}">
      <div class="sz-name">Cliente</div>
      <div class="sz-tag">Pides comida desde tu zona</div>
      <button class="pickBtn" data-pick-role="cliente">Soy Cliente</button>
    </div>
    <div class="sz-card" style="--zone-color:${'#FF4F1F'}">
      <div class="sz-name">Operaciones</div>
      <div class="sz-tag">Decides qué zonas y tiendas operan</div>
      <button class="pickBtn" data-pick-role="operaciones">Soy Operaciones</button>
    </div>
  `;
  document.querySelectorAll('[data-pick-role]').forEach(btn=>{
    btn.addEventListener('click', () => {
      myRole = btn.getAttribute('data-pick-role');
      if (myRole === 'cliente' && !myZone){
        myZone = ZONES[Math.floor(Math.random() * ZONES.length)].id;
      }
      render();
    });
  });
}

function renderClientPane(){
  const home = ZONES.find(zz => zz.id === myZone);
  const neighborIds = ADJACENCY[myZone] || [];
  studentTitleEl.textContent = `Tu zona: ${home.name}`;
  studentSubEl.textContent = 'Puedes pedir en tu zona o en zonas vecinas — no puedes cambiar tu zona asignada.';

  let html = buildStudentCardHtml(home, { homeTag: true });
  neighborIds.forEach(nid => {
    const nz = ZONES.find(zz => zz.id === nid);
    const blocked = isEdgeBlocked(nid, myZone);
    html += buildStudentCardHtml(nz, { blocked });
  });
  studentGrid.innerHTML = html;

  document.querySelectorAll('.orderBtn[data-order-zone]').forEach(btn=>{
    btn.addEventListener('click', () => placeOrder(btn.getAttribute('data-order-zone')));
  });
  document.querySelectorAll('.quiz-opt').forEach(btn=>{
    btn.addEventListener('click', () => answerQuiz(btn.getAttribute('data-quiz-zone'), parseInt(btn.getAttribute('data-quiz-opt'), 10)));
  });
}

function renderOpsPane(){
  studentTitleEl.textContent = 'Panel de Operaciones';
  studentSubEl.textContent = 'Decide qué zonas y tiendas operan, y desde dónde se puede pedir.';

  studentGrid.innerHTML = ZONES.map(z => {
    const s = state[z.id];
    const closed = isZoneClosed(s);
    const color = colorForStress(s.stress);
    const storesHtml = s.stores.map(st => `
      <button class="quiz-opt" data-store-zone="${z.id}" data-store-id="${st.id}" style="margin-bottom:5px;">
        ${st.closed ? '🔴' : '🟢'} ${st.name}: ${st.closed ? 'Cerrada' : 'Abierta'}
      </button>
    `).join('');
    const neighborHtml = (ADJACENCY[z.id] || []).map(nid => {
      const nz = ZONES.find(zz=>zz.id===nid);
      const blocked = isEdgeBlocked(z.id, nid);
      return `
        <button class="quiz-opt" data-edge-target="${z.id}" data-edge-source="${nid}" style="margin-bottom:5px;">
          ${blocked ? '🚫' : '✅'} Pedidos desde ${nz.name}: ${blocked ? 'Bloqueados' : 'Permitidos'}
        </button>
      `;
    }).join('');

    return `
      <div class="sz-card" style="--zone-color:${color}; text-align:left;">
        <div class="sz-name" style="text-align:center;">${s.name}</div>
        <div class="sz-tag" style="text-align:center;">${closed ? 'Cerrada' : Math.round(s.eta) + ' min · ' + Math.round(s.stress*100) + '% de capacidad'}</div>
        <div class="quiz" style="margin-top:12px;">
          <div class="quiz-q">Zona</div>
          <button class="quiz-opt" data-zone-toggle="${z.id}">${s.manualClosed ? '🔓 Reabrir zona' : '🔒 Cerrar zona completa'}</button>
          <div class="quiz-q" style="margin-top:10px;">Tiendas</div>
          ${storesHtml}
          <div class="quiz-q" style="margin-top:10px;">ETA manual: +${s.etaBoost || 0} min</div>
          <button class="quiz-opt" data-eta-zone="${z.id}" data-eta-dir="1">➕ Subir ETA ${ETA_BOOST_STEP} min</button>
          <button class="quiz-opt" data-eta-zone="${z.id}" data-eta-dir="-1">➖ Bajar ETA ${ETA_BOOST_STEP} min</button>
          ${neighborHtml ? `<div class="quiz-q" style="margin-top:10px;">Tráfico entre zonas</div>${neighborHtml}` : ''}
        </div>
      </div>
    `;
  }).join('');

  document.querySelectorAll('[data-zone-toggle]').forEach(btn=>{
    btn.addEventListener('click', () => opsToggleZone(btn.getAttribute('data-zone-toggle')));
  });
  document.querySelectorAll('[data-store-zone]').forEach(btn=>{
    btn.addEventListener('click', () => opsToggleStore(btn.getAttribute('data-store-zone'), btn.getAttribute('data-store-id')));
  });
  document.querySelectorAll('[data-eta-zone]').forEach(btn=>{
    btn.addEventListener('click', () => opsAdjustEta(btn.getAttribute('data-eta-zone'), parseInt(btn.getAttribute('data-eta-dir'), 10)));
  });
  document.querySelectorAll('[data-edge-target]').forEach(btn=>{
    btn.addEventListener('click', () => opsToggleEdge(btn.getAttribute('data-edge-target'), btn.getAttribute('data-edge-source')));
  });
}

function renderStudentPane(){
  if (!myRole){
    renderRolePicker();
  } else if (myRole === 'cliente'){
    renderClientPane();
  } else {
    renderOpsPane();
  }
}

function renderHealthPanel(){
  let totalVolume = 0, totalCap = 0, openCount = 0, closedCount = 0, closedStores = 0, blockedCount = blockedEdges.size;
  ZONES.forEach(z => {
    const s = state[z.id];
    totalVolume += s.volume;
    totalCap += effectiveCapacity(s);
    if (isZoneClosed(s)) closedCount++; else openCount++;
    closedStores += s.stores.filter(st => st.closed).length;
  });
  const healthPct = totalCap > 0 ? Math.min(100, Math.round((totalVolume / totalCap) * 100)) : 100;
  const healthColor = healthPct < 75 ? '#078A72' : healthPct < 115 ? '#C77A00' : '#D63846';
  healthPanelEl.innerHTML = `
    <div class="health-item"><div class="health-n" style="color:${healthColor}">${healthPct}%</div><div class="health-l">Capacidad usada</div></div>
    <div class="health-item"><div class="health-n">${openCount}/${ZONES.length}</div><div class="health-l">Zonas abiertas</div></div>
    <div class="health-item"><div class="health-n">${closedStores}</div><div class="health-l">Tiendas cerradas</div></div>
    <div class="health-item"><div class="health-n">${blockedCount}</div><div class="health-l">Rutas bloqueadas</div></div>
  `;
}

function render(){
  let etaSum = 0, openZones = 0;

  if (isHost) grid.innerHTML = '';

  ZONES.forEach(z => {
    const s = state[z.id];
    const isClosed = isZoneClosed(s);
    if (!isClosed) { etaSum += s.eta; openZones++; }

    if (isHost){
      const color = colorForStress(s.stress);
      const pct = Math.min(100, s.stress * 100);
      const card = document.createElement('div');
      card.className = 'zone' + (isClosed ? ' closed' : '');
      card.style.setProperty('--zone-color', color);

      const etaHtml = isClosed
        ? `Zona cerrada`
        : `${Math.round(s.eta)}<span style="font-size:16px;">min</span>`;

      const storesClosed = s.stores.filter(st=>st.closed).length;
      const badge = s.manualClosed
        ? `<div class="closed-badge badge-manual">🔒 Cierre manual</div>`
        : s.autoClosed
          ? `<div class="closed-badge badge-auto">⛔ Saturada — auto-cerrada</div>`
          : storesClosed > 0
            ? `<div class="closed-badge badge-manual">🏬 ${storesClosed} tienda(s) cerrada(s)</div>`
            : '';

      const promoBtnHtml = isClosed
        ? `<button class="promoBtn" disabled>🔔 No disponible</button>`
        : `<button data-zone="${z.id}" class="promoBtn">🔔 Enviar promoción</button>`;

      const toggleLabel = s.manualClosed ? '🔓 Reabrir zona (manual)' : '🔒 Cerrar zona (manual)';

      card.innerHTML = `
        <div class="zone-head">
          <div>
            <div class="zone-name">${s.name}</div>
            <div class="zone-tag">${s.tag}</div>
          </div>
        </div>
        <div class="eta-block">
          <div class="eta-num">${etaHtml}</div>
          <div class="eta-label">${isClosed ? 'No se aceptan nuevos pedidos' : 'ETA mostrado al usuario'}${s.etaBoost ? ' (+' + s.etaBoost + ' manual)' : ''}</div>
          ${badge}
        </div>
        <div class="bar-track"><div class="bar-fill" style="width:${pct}%;"></div></div>
        <div class="zone-meta">
          <span>Demanda: ${Math.round(s.volume)}</span>
          <span>Capacidad: ${Math.round(effectiveCapacity(s))}</span>
        </div>
        ${promoBtnHtml}
        <button data-zone-toggle="${z.id}" class="closeToggle">${toggleLabel}</button>
      `;
      grid.appendChild(card);
    }
  });

  totalOrdersEl.textContent = totalOrders;
  avgEtaEl.textContent = openZones ? Math.round(etaSum / openZones) + ' min' : '—';

  if (isHost){
    renderHealthPanel();
    document.querySelectorAll('.promoBtn:not([disabled])').forEach(btn=>{
      btn.addEventListener('click', () => sendPromo(btn.getAttribute('data-zone')));
    });
    document.querySelectorAll('.closeToggle').forEach(btn=>{
      btn.addEventListener('click', () => toggleManualClose(btn.getAttribute('data-zone-toggle')));
    });
  } else {
    renderStudentPane();
  }
}

function log(msg, hot){
  const line = document.createElement('div');
  if (hot) line.className = 'hot';
  line.innerHTML = msg;
  logEl.prepend(line);
  while (logEl.children.length > 40) logEl.removeChild(logEl.lastChild);
}

function pulseZone(id){
  const cards = document.querySelectorAll('.zone');
  cards.forEach(c => {
    if (c.querySelector(`[data-zone="${id}"]`)) {
      c.classList.add('pulse');
      setTimeout(()=>c.classList.remove('pulse'), 1100);
    }
  });
}

function sendPromo(id){
  const s = state[id];
  if (isZoneClosed(s)) return;
  const boost = s.capacity * PROMO_BOOST_RATIO;
  s.volume += boost;
  const newOrders = Math.round(boost);
  totalOrders += newOrders;
  pulseZone(id);
  log(`🔔 Promo enviada a <span>${s.name}</span> — +${newOrders} pedidos entrantes`, true);
}

function toggleManualClose(id){
  const s = state[id];
  s.manualClosed = !s.manualClosed;
  if (s.manualClosed){
    log(`🔒 <span>${s.name}</span> cerrada manualmente — este grupo ya no puede pedir`, true);
  } else {
    log(`🔓 <span>${s.name}</span> reabierta manualmente`);
  }
  render();
}

function setMode(host){
  isHost = host;
  hostViewEl.classList.toggle('hidden', !host);
  studentViewEl.classList.toggle('hidden', host);
  modeToggleEl.textContent = host ? 'Volver a vista de participante' : 'Abrir tablero general';
  modeHintEl.innerHTML = host
    ? '<b>Tablero general activo.</b> Comparte este mismo enlace con los participantes; cada dispositivo puede elegir Cliente u Operaciones.'
    : '<b>Vista de participante.</b> Elige un rol para entrar a la simulación. Si estás presentando, abre el tablero general.';
  render();
}

document.getElementById('modeToggle').addEventListener('click', ()=>{
  if (isHost){
    setMode(false); // leaving host mode never needs a password
  } else {
    openPasswordModal();
  }
});

function openPasswordModal(){
  passwordErrorEl.textContent = '';
  passwordInputEl.value = '';
  passwordModalEl.classList.remove('hidden');
  setTimeout(()=> passwordInputEl.focus(), 30);
}

function closePasswordModal(){
  passwordModalEl.classList.add('hidden');
}

async function submitPassword(){
  const password = passwordInputEl.value;
  passwordErrorEl.textContent = 'Verificando…';
  try {
    const response = await fetch('/api/presenter/verify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password }),
    });
    if (response.ok) {
      closePasswordModal();
      setMode(true);
      return;
    }
    passwordErrorEl.textContent = 'Contraseña incorrecta';
    passwordCardEl.classList.add('shake');
    setTimeout(()=> passwordCardEl.classList.remove('shake'), 300);
    passwordInputEl.value = '';
    passwordInputEl.focus();
  } catch (error) {
    passwordErrorEl.textContent = 'No fue posible conectar con el servidor';
  }
}

document.getElementById('passwordSubmit').addEventListener('click', submitPassword);
document.getElementById('passwordCancel').addEventListener('click', closePasswordModal);
passwordInputEl.addEventListener('keydown', (e)=>{
  if (e.key === 'Enter') submitPassword();
});

function answerQuiz(zoneId, optionIndex){
  const qs = quizState[zoneId];
  const question = QUIZ[qs.qIndex];
  if (optionIndex === question.correct){
    qs.unlocked = true;
    qs.wrong = false;
  } else {
    qs.wrong = true;
  }
  render();
}

async function placeOrder(zoneId){
  const s = state[zoneId];
  if (!s || isZoneClosed(s)) return;
  if (!isHost){
    if (myRole !== 'cliente') return;
    const allowed = zoneId === myZone || (ADJACENCY[myZone] || []).includes(zoneId);
    if (!allowed) return;
    if (zoneId !== myZone && isEdgeBlocked(zoneId, myZone)) return;
  }
  cooldownUntil[zoneId] = Date.now() + 5000;
  // lock the quiz again with a fresh question for next time
  quizState[zoneId] = { qIndex: Math.floor(Math.random() * QUIZ.length), unlocked: false, wrong: false };
  render();

  const key = `order:${zoneId}:${Date.now()}-${Math.random().toString(36).slice(2,8)}`;
  processedOrderKeys.add(key); // don't double-count this tap when we poll shared storage

  // optimistic local update so the tapper sees it instantly
  const size = Math.round(ORGANIC_MIN + Math.random() * (ORGANIC_MAX - ORGANIC_MIN));
  s.volume += size;
  totalOrders += size;

  try{
    await window.storage.set(key, JSON.stringify({ zone: zoneId, ts: Date.now() }), true);
  } catch(e){
    // best-effort — the tapper's own view already updated even if the sync failed
  }
}

async function pollSharedOrders(){
  try{
    const res = await window.storage.list('order:', true);
    if (!res || !res.keys || !res.keys.length) return;
    let sawNew = false;
    for (const key of res.keys){
      if (processedOrderKeys.has(key)) {
        if (isHost) window.storage.delete(key, true).catch(()=>{});
        continue;
      }
      processedOrderKeys.add(key);
      const parts = key.split(':');
      const zoneId = parts[1];
      const s = state[zoneId];
      if (s && !isZoneClosed(s)){
        const size = Math.round(ORGANIC_MIN + Math.random() * (ORGANIC_MAX - ORGANIC_MIN));
        s.volume += size;
        totalOrders += size;
        pulseZone(zoneId);
        sawNew = true;
        if (isHost) log(`📱 Pedido de un estudiante en <span>${s.name}</span>`);
      }
      if (isHost) window.storage.delete(key, true).catch(()=>{});
    }
    if (sawNew) render();
  } catch(e){
    // no shared orders yet, or storage briefly unavailable — ignore and retry next poll
  }
}

function pushLogEvent(msg){
  const key = `log:${Date.now()}-${Math.random().toString(36).slice(2,8)}`;
  processedLogKeys.add(key);
  window.storage.set(key, JSON.stringify({ msg }), true).catch(()=>{});
}

function opsToggleZone(zoneId){
  const s = state[zoneId];
  s.manualClosed = !s.manualClosed;
  pushLogEvent(s.manualClosed
    ? `🔒 Operaciones cerró <span>${s.name}</span> por completo`
    : `🔓 Operaciones reabrió <span>${s.name}</span>`);
  pushOpsState();
  render();
}

function opsToggleStore(zoneId, storeId){
  const s = state[zoneId];
  const st = s.stores.find(x => x.id === storeId);
  if (!st) return;
  st.closed = !st.closed;
  pushLogEvent(`🏬 Operaciones ${st.closed ? 'cerró' : 'abrió'} ${st.name} en <span>${s.name}</span>`);
  pushOpsState();
  render();
}

function opsAdjustEta(zoneId, dir){
  const s = state[zoneId];
  const next = (s.etaBoost || 0) + dir * ETA_BOOST_STEP;
  s.etaBoost = Math.max(0, Math.min(ETA_BOOST_MAX, next));
  pushLogEvent(`⏱️ Operaciones ajustó el ETA manual de <span>${s.name}</span> a +${s.etaBoost} min`);
  pushOpsState();
  render();
}

function opsToggleEdge(target, source){
  const key = edgeKey(target, source);
  const targetZone = state[target], sourceZone = state[source];
  if (blockedEdges.has(key)){
    blockedEdges.delete(key);
    pushLogEvent(`✅ Operaciones permitió pedidos desde <span>${sourceZone.name}</span> hacia ${targetZone.name}`);
  } else {
    blockedEdges.add(key);
    pushLogEvent(`🚫 Operaciones bloqueó pedidos desde <span>${sourceZone.name}</span> hacia ${targetZone.name}`);
  }
  pushOpsState();
  render();
}

function pushOpsState(){
  const payload = {
    zones: {},
    blockedEdges: Array.from(blockedEdges),
  };
  ZONES.forEach(z => {
    const s = state[z.id];
    payload.zones[z.id] = {
      manualClosed: s.manualClosed,
      etaBoost: s.etaBoost || 0,
      stores: s.stores.map(st => ({ id: st.id, closed: st.closed })),
    };
  });
  window.storage.set('ops:global', JSON.stringify(payload), true).catch(()=>{});
}

function applyOpsState(parsed){
  if (!parsed || !parsed.zones) return;
  ZONES.forEach(z => {
    const zp = parsed.zones[z.id];
    if (!zp) return;
    const s = state[z.id];
    s.manualClosed = !!zp.manualClosed;
    s.etaBoost = zp.etaBoost || 0;
    if (Array.isArray(zp.stores)){
      zp.stores.forEach(stp => {
        const st = s.stores.find(x => x.id === stp.id);
        if (st) st.closed = !!stp.closed;
      });
    }
  });
  blockedEdges = new Set(Array.isArray(parsed.blockedEdges) ? parsed.blockedEdges : []);
}

async function pollOpsState(){
  try{
    const res = await window.storage.get('ops:global', true);
    if (res && res.value){
      applyOpsState(JSON.parse(res.value));
      render();
    }
  } catch(e){
    // no shared ops state yet — defaults apply
  }
}

async function pollSharedLog(){
  if (!isHost) return;
  try{
    const res = await window.storage.list('log:', true);
    if (!res || !res.keys || !res.keys.length) return;
    for (const key of res.keys){
      if (!processedLogKeys.has(key)){
        try{
          const item = await window.storage.get(key, true);
          if (item && item.value){
            const parsed = JSON.parse(item.value);
            log(parsed.msg, true);
          }
        } catch(e){}
        processedLogKeys.add(key);
      }
      window.storage.delete(key, true).catch(()=>{});
    }
  } catch(e){
    // no shared log entries yet
  }
}

document.getElementById('promoAll').addEventListener('click', ()=>{
  ZONES.forEach(z => sendPromo(z.id));
  log(`📣 Promoción citywide activada en las 6 zonas`, true);
});

document.getElementById('resetBtn').addEventListener('click', ()=>{
  ZONES.forEach(z => {
    state[z.id].volume = z.baseVolume;
    state[z.id].eta = BASE_ETA;
    state[z.id].stress = z.baseVolume / z.capacity;
    state[z.id].autoClosed = false;
    state[z.id].manualClosed = false;
    state[z.id].closedTicks = 0;
    state[z.id].etaBoost = 0;
    state[z.id].stores.forEach(st => st.closed = false);
  });
  blockedEdges = new Set();
  totalOrders = 0;
  logEl.innerHTML = '';
  log('↺ Simulación reiniciada');
  pushOpsState();
  render();
});

document.getElementById('speedToggle').addEventListener('click', (e)=>{
  speedMultiplier = speedMultiplier === 1 ? 3 : 1;
  e.target.textContent = speedMultiplier === 1 ? 'Velocidad: normal' : 'Velocidad: rápida';
});

document.getElementById('organicToggle').addEventListener('click', (e)=>{
  organicEnabled = !organicEnabled;
  e.target.textContent = organicEnabled ? 'Demanda aleatoria: activa' : 'Demanda aleatoria: pausada';
  log(organicEnabled ? '🎲 Pedidos orgánicos reanudados' : '🎲 Pedidos orgánicos pausados');
});

function tick(){
  ZONES.forEach(z => {
    const s = state[z.id];
    const isClosed = isZoneClosed(s);
    const capNow = effectiveCapacity(s);

    // organic, unprompted orders — only land if the zone is open
    if (organicEnabled && !isClosed && Math.random() < ORGANIC_CHANCE){
      const size = Math.round(ORGANIC_MIN + Math.random() * (ORGANIC_MAX - ORGANIC_MIN));
      s.volume += size;
      totalOrders += size;
    }

    // decay volume back toward baseline (couriers catching up / orders completing)
    s.volume += (z.baseVolume - s.volume) * DECAY_RATE * speedMultiplier;
    if (s.volume < z.baseVolume) s.volume = z.baseVolume;
    s.stress = capNow > 0 ? s.volume / capNow : 999;

    if (!isClosed){
      const overload = Math.max(0, s.stress - 1);
      const boost = Math.min(ETA_BOOST_MAX, Math.max(0, s.etaBoost || 0));
      s.eta = BASE_ETA + overload * SURGE_FACTOR + boost;
    }

    // auto-close an overloaded zone; auto-reopen once it cools down for long enough
    if (!s.manualClosed){
      if (!s.autoClosed && s.stress >= AUTO_CLOSE_STRESS){
        s.autoClosed = true;
        s.closedTicks = 0;
        log(`⛔ <span>${s.name}</span> se cerró automáticamente — demanda muy por encima de la capacidad`, true);
      } else if (s.autoClosed){
        s.closedTicks++;
        if (s.stress <= AUTO_REOPEN_STRESS && s.closedTicks >= MIN_CLOSED_TICKS){
          s.autoClosed = false;
          log(`✅ <span>${s.name}</span> se reabrió — la demanda volvió a niveles manejables`);
        }
      }
    }
  });
  render();
}

setMode(false);
log('Simulación lista. Envía una promoción a una zona para ver el efecto en el ETA.');
tickHandle = setInterval(tick, 1000);
setInterval(pollSharedOrders, 1500);
setInterval(pollOpsState, 2000);
setInterval(pollSharedLog, 1800);
pollOpsState();
</script>
</body>
</html>
