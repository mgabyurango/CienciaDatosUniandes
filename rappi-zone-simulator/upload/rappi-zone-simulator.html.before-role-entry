<script>
// Shared storage backed by this app's own server.
window.storage = {
  async set(key, value) {
    const response = await fetch('/api/storage', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key, value }),
    });
    if (!response.ok) throw new Error('No se pudo guardar el evento');
    return response.json();
  },
  async get(key) {
    const response = await fetch(`/api/storage?key=${encodeURIComponent(key)}`);
    if (!response.ok) throw new Error('No se pudo leer el estado');
    return response.json();
  },
  async list(prefix) {
    const response = await fetch(`/api/storage?prefix=${encodeURIComponent(prefix)}`);
    if (!response.ok) throw new Error('No se pudo listar el estado');
    return response.json();
  },
  async delete(key) {
    const response = await fetch(`/api/storage?key=${encodeURIComponent(key)}`, { method: 'DELETE' });
    if (!response.ok) throw new Error('No se pudo eliminar el evento');
    return response.json();
  },
};

const ZONES = [
  { id:'chapinero', name:'Chapinero', tag:'Zona T', baseVolume:40, capacity:55,
    stores:[{id:'a',name:'Tienda A',share:0.5},{id:'b',name:'Tienda B',share:0.5}] },
