<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rappi Live Ops — Simulador de Zonas</title>
<style>
  :root{
    --bg:#0B0D12;
    --panel:#12151D;
    --panel2:#171B26;
    --border:#232838;
    --text:#E8EAED;
    --text-dim:#8B93A7;
    --accent:#FF4713;
    --accent-dim:#8a2c10;
    --cool:#2DD4BF;
    --mid:#F5A623;
    --hot:#FB3748;
    --mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    --sans: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(circle at 15% 0%, rgba(255,71,19,0.10), transparent 45%),
      radial-gradient(circle at 85% 100%, rgba(45,212,191,0.08), transparent 45%),
      var(--bg);
    color:var(--text);
    font-family:var(--sans);
    min-height:100vh;
    padding:28px 32px 60px;
  }
  .wrap{max-width:1180px;margin:0 auto;}

  header{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:20px;
    border-bottom:1px solid var(--border);
    padding-bottom:18px;
    margin-bottom:22px;
    flex-wrap:wrap;
  }
  .eyebrow{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--accent);
    margin-bottom:6px;
  }
  h1{
    font-size:26px;
    margin:0;
    font-weight:700;
    letter-spacing:-0.01em;
  }
  .sub{color:var(--text-dim);font-size:13.5px;margin-top:6px;max-width:520px;line-height:1.5;}

  .stat-strip{display:flex;gap:22px;font-family:var(--mono);}
  .stat{text-align:right;}
  .stat .n{font-size:22px;font-weight:700;}
  .stat .l{font-size:10.5px;color:var(--text-dim);letter-spacing:0.08em;text-transform:uppercase;}

  .toolbar{
    display:flex;
    gap:10px;
    margin-bottom:22px;
    flex-wrap:wrap;
    align-items:center;
  }
  button{
    font-family:var(--sans);
    font-size:13px;
    font-weight:600;
    border-radius:8px;
    border:1px solid var(--border);
    background:var(--panel2);
    color:var(--text);
    padding:9px 14px;
    cursor:pointer;
    transition:transform .08s ease, border-color .15s ease, background .15s ease;
  }
  button:hover{border-color:#3a4258;}
  button:active{transform:scale(0.97);}
  .btn-primary{
    background:var(--accent);
    border-color:var(--accent);
    color:#fff;
  }
  .btn-primary:hover{background:#e63d0f;}
  .btn-ghost{background:transparent;}
  .spacer{flex:1;}

  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(230px, 1fr));
    gap:14px;
    margin-bottom:26px;
  }

  .zone{
    position:relative;
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:14px;
    padding:18px 18px 16px;
    overflow:hidden;
    transition:border-color .3s ease;
  }
  .zone::before{
    content:'';
    position:absolute;
    inset:0;
    background:var(--zone-color, var(--cool));
    opacity:0.06;
    transition:opacity .4s ease, background .4s ease;
  }
  .zone.pulse::after{
    content:'';
    position:absolute;
    top:14px;right:14px;
    width:9px;height:9px;
    border-radius:50%;
    background:var(--accent);
    box-shadow:0 0 0 0 rgba(255,71,19,0.6);
    animation:ping 1.1s ease-out;
  }
  @keyframes ping{
    0%{box-shadow:0 0 0 0 rgba(255,71,19,0.55);}
    100%{box-shadow:0 0 0 22px rgba(255,71,19,0);}
  }

  .zone-head{display:flex;justify-content:space-between;align-items:flex-start;position:relative;z-index:1;}
  .zone-name{font-weight:700;font-size:15.5px;}
  .zone-tag{font-family:var(--mono);font-size:10.5px;color:var(--text-dim);margin-top:2px;}

  .eta-block{margin:16px 0 10px;position:relative;z-index:1;}
  .eta-num{
    font-family:var(--mono);
    font-size:38px;
    font-weight:700;
    line-height:1;
    color:var(--zone-color, var(--cool));
    transition:color .4s ease;
  }
  .eta-label{font-size:10.5px;color:var(--text-dim);letter-spacing:0.08em;text-transform:uppercase;margin-top:4px;}

  .bar-track{
    height:6px;
    border-radius:4px;
    background:#1e2230;
    overflow:hidden;
    margin:12px 0 4px;
    position:relative;z-index:1;
  }
  .bar-fill{
    height:100%;
    width:0%;
    background:var(--zone-color, var(--cool));
    transition:width .5s ease, background .4s ease;
  }
  .zone-meta{
    display:flex;justify-content:space-between;
    font-family:var(--mono);font-size:11px;color:var(--text-dim);
    margin-bottom:14px;position:relative;z-index:1;
  }

  .zone button{
    width:100%;
    position:relative;z-index:1;
    font-size:12.5px;
  }
  .zone .closeToggle{
    margin-top:7px;
    background:transparent;
    border:1px solid transparent;
    color:var(--text-dim);
    font-size:10.5px;
    padding:5px 8px;
  }
  .zone .closeToggle:hover{color:var(--text);border-color:var(--border);}

  .zone.closed{border-color:#3a2530;}
  .zone.closed::before{background:var(--hot);opacity:0.10;}
  .zone.closed .eta-num{color:var(--hot) !important;font-size:19px;}
  .zone.closed .bar-fill{background:var(--hot) !important;width:100% !important;}
  .closed-badge{
    display:none;
    position:relative;z-index:1;
    font-family:var(--mono);
    font-size:10px;
    letter-spacing:0.06em;
    text-transform:uppercase;
    color:var(--hot);
    background:rgba(251,55,72,0.12);
    border:1px solid rgba(251,55,72,0.35);
    border-radius:6px;
    padding:3px 7px;
    margin-top:2px;
  }
  .zone.closed .closed-badge{display:inline-block;}
  .zone.closed .promoBtn{opacity:0.4;cursor:not-allowed;}

  .badge-auto{color:var(--hot);}
  .badge-manual{color:var(--text-dim);border-color:var(--border);background:transparent;}

  .log-panel{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:14px;
    padding:16px 18px;
  }
  .log-panel h2{
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:0.1em;
    color:var(--text-dim);
    margin:0 0 10px;
    font-weight:700;
  }
  #log{
    font-family:var(--mono);
    font-size:12.5px;
    max-height:150px;
    overflow-y:auto;
    display:flex;
    flex-direction:column-reverse;
  }
  #log div{padding:4px 0;border-bottom:1px dashed #1c2130;color:var(--text-dim);}
  #log div span{color:var(--text);}
  #log div.hot{color:var(--hot);}

  .legend{
    display:flex;gap:18px;margin-top:14px;flex-wrap:wrap;
    font-family:var(--mono);font-size:11px;color:var(--text-dim);
  }
  .legend span{display:inline-flex;align-items:center;gap:6px;}
  .dot{width:8px;height:8px;border-radius:50%;display:inline-block;}

  footer{margin-top:30px;color:var(--text-dim);font-size:11.5px;text-align:center;}

  .hidden{display:none !important;}

  .mode-bar{
    display:flex;
    align-items:center;
    gap:12px;
    flex-wrap:wrap;
    background:var(--panel2);
    border:1px solid var(--border);
    border-radius:12px;
    padding:12px 16px;
    margin-bottom:22px;
  }
  .mode-bar .hint{font-size:12px;color:var(--text-dim);line-height:1.5;flex:1;min-width:200px;}
  .mode-bar .hint b{color:var(--text);}

  .student-intro{
    text-align:center;
    margin-bottom:26px;
  }
  .student-intro h1{font-size:22px;}
  .student-intro .sub{margin:8px auto 0;max-width:420px;text-align:center;}

  .student-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));
    gap:14px;
  }
  .sz-card{
    position:relative;
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:16px;
    padding:20px;
    text-align:center;
    overflow:hidden;
  }
  .sz-card::before{
    content:'';
    position:absolute;inset:0;
    background:var(--zone-color, var(--cool));
    opacity:0.07;
  }
  .sz-name{font-weight:700;font-size:16px;position:relative;z-index:1;}
  .sz-tag{font-family:var(--mono);font-size:10.5px;color:var(--text-dim);margin-top:2px;position:relative;z-index:1;}
  .sz-eta{
    font-family:var(--mono);
    font-weight:700;
    font-size:26px;
    color:var(--zone-color, var(--cool));
    margin:14px 0 2px;
    position:relative;z-index:1;
  }
  .sz-eta-label{font-size:10px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.07em;position:relative;z-index:1;}
  .orderBtn{
    width:100%;
    margin-top:14px;
    position:relative;z-index:1;
    font-size:14px;
    padding:13px 14px;
  }
  .orderBtn.sent{background:var(--cool);border-color:var(--cool);color:#06231f;}
  .sz-note{
    font-size:11px;
    color:var(--text-dim);
    margin-top:8px;
    position:relative;z-index:1;
    min-height:14px;
  }

  .quiz{position:relative;z-index:1;margin-top:14px;text-align:left;}
  .quiz-q{font-size:12.5px;font-weight:600;margin-bottom:9px;line-height:1.4;}
  .quiz-opt{
    width:100%;
    text-align:left;
    font-size:12px;
    font-weight:500;
    padding:9px 11px;
    margin-bottom:6px;
    background:var(--panel2);
  }
  .quiz-opt:last-child{margin-bottom:0;}
  .quiz-msg{font-size:11px;margin-top:6px;min-height:14px;}
  .quiz-msg.wrong{color:var(--hot);}
  .quiz-msg.right{color:var(--cool);}

  .pickBtn{width:100%;margin-top:14px;position:relative;z-index:1;font-size:13.5px;}
  .changeZoneWrap{text-align:center;margin-top:16px;}
  .changeZoneWrap button{font-size:11.5px;}

  .health-panel{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(140px, 1fr));
    gap:12px;
    margin-bottom:20px;
  }
  .health-item{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:12px;
    padding:14px 16px;
    text-align:center;
  }
  .health-n{font-family:var(--mono);font-size:24px;font-weight:700;}
  .health-l{font-size:10px;color:var(--text-dim);letter-spacing:0.06em;text-transform:uppercase;margin-top:4px;}

  .modal-overlay{
    position:fixed;inset:0;
    background:rgba(6,7,10,0.72);
    display:flex;align-items:center;justify-content:center;
    z-index:100;
    padding:20px;
  }
  .modal-card{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:16px;
    padding:26px 24px;
    width:280px;
    text-align:center;
  }
  .modal-card h3{margin:0 0 4px;font-size:16px;}
  .modal-card p{margin:0 0 14px;font-size:12px;color:var(--text-dim);}
  .modal-card input{
    width:100%;
    padding:11px 12px;
    border-radius:8px;
    border:1px solid var(--border);
    background:var(--panel2);
    color:var(--text);
    font-family:var(--mono);
    font-size:15px;
    text-align:center;
    letter-spacing:0.08em;
    box-sizing:border-box;
  }
  .modal-error{color:var(--hot);font-size:11.5px;min-height:16px;margin-top:8px;}
  .modal-actions{display:flex;gap:8px;margin-top:14px;}
  .modal-actions button{flex:1;}
  @keyframes shake{
    0%,100%{transform:translateX(0);}
    25%{transform:translateX(-6px);}
    75%{transform:translateX(6px);}
  }
  .shake{animation:shake .3s ease;}

