    <input type="password" id="passwordInput" placeholder="Contraseña" autocomplete="off">
    <div class="modal-error" id="passwordError"></div>
    <div class="modal-actions">
      <button class="btn-ghost" id="passwordCancel">Cancelar</button>
      <button class="btn-primary" id="passwordSubmit">Entrar</button>
    </div>
  </div>
