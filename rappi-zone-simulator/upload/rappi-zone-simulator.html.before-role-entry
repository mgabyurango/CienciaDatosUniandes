function edgeKey(target, source){ return `${target}|${source}`; }
function isEdgeBlocked(target, source){ return blockedEdges.has(edgeKey(target, source)); }

function effectiveCapacity(s){
  const openShare = s.stores.reduce((sum, st) => sum + (st.closed ? 0 : st.share), 0);
  return s.capacity * openShare;
}

function isZoneClosed(s){
  return s.manualClosed || s.autoClosed || effectiveCapacity(s) <= 0;
}

