    <div class="student-grid" id="studentGrid"></div>
  </div>

  <footer>Simulación ilustrativa para fines educativos — construida para la charla de Data Science en la Universidad de Los Andes.</footer>
</div>

<div class="modal-overlay hidden" id="passwordModal">
  <div class="modal-card" id="passwordCard">
